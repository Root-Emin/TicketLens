# TicketLens production environment — copy to deployments/.env.prod and fill in.
#
#   ./scripts/gen-secrets.sh > deployments/.env.prod
#
# That script writes this file with the three secrets already generated; you
# then set APP_DOMAIN, ACME_EMAIL and IMAGE_TAG by hand. .env.prod is gitignored
# and must never be committed — it is the only copy of the JWT signing key, and
# rotating it signs every existing session out.
#
# Used as:
#   docker compose -f deployments/docker-compose.prod.yml \
#                  --env-file deployments/.env.prod up -d

# ─── Public identity ──────────────────────────────────────────────────────────
# The hostname the product is served on. Its DNS A record must already point at
# this host before the stack starts, or Caddy cannot complete the ACME challenge.
APP_DOMAIN=app.example.com

# Let's Encrypt sends expiry warnings here. Use an address somebody reads.
ACME_EMAIL=ops@example.com

# ─── Release ──────────────────────────────────────────────────────────────────
# Where the release workflow pushes images, and which release to run. All three
# images move together — never mix tags across services.
GHCR_REPO=ghcr.io/root-emin
IMAGE_TAG=v0.1.0

# ─── Secrets (generated — never copy these values between environments) ───────
# At least 32 characters; the backend refuses to start with anything shorter or
# with the development default. Changing it invalidates all issued tokens.
JWT_SECRET=

POSTGRES_PASSWORD=
REDIS_PASSWORD=

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=ticketlens
POSTGRES_DB=ticketlens

# disable is correct while Postgres runs in this stack, on a compose network
# marked internal that is not routed off the host. Switch to `require` the
# moment DB_HOST points at a managed or remote instance — the backend logs a
# warning about this at every startup so the choice stays visible.
DB_SSLMODE=disable

# ─── Sessions ─────────────────────────────────────────────────────────────────
JWT_EXPIRATION_HOURS=24

# ─── Onboarding ───────────────────────────────────────────────────────────────
# Staff join by invitation, so public self-signup stays off: the backend does not
# mount POST /auth/register at all unless this is set, and on a multi-tenant
# deployment an open registration endpoint lets anyone create a platform account.
# ALLOW_PUBLIC_REGISTRATION=false

# How long an invitation link stays redeemable. 168 hours = 7 days.
INVITATION_TTL_HOURS=168

# ─── Mail ─────────────────────────────────────────────────────────────────────
# Leave SMTP_HOST empty and invitation emails are written to the backend log —
# tokens included — instead of being delivered. The product still works, because
# creating an invitation returns the link in the API response for an
# administrator to pass on, but nobody receives anything. Configure a relay
# before onboarding a customer's staff.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=TicketLens <no-reply@example.com>

# ─── Classifier ───────────────────────────────────────────────────────────────
# With the stub fallback on, a classifier outage degrades triage quality instead
# of failing ticket creation. Confirm the real model is live after a deploy:
#   docker compose exec classifier \
#     python -c "import urllib.request;print(urllib.request.urlopen('http://127.0.0.1:8091/healthz').read())"
# It must report TorchBackend. StubBackend means the image shipped without a
# checkpoint and every ticket is being triaged by keyword matching.
CLASSIFIER_TIMEOUT_MS=5000
CLASSIFIER_FALLBACK_TO_STUB=true
CLASSIFIER_REVIEW_THRESHOLD=0.60

# ─── Backups ──────────────────────────────────────────────────────────────────
# The backup service dumps on this interval and keeps this many days. Dumps land
# in deployments/backup/dumps on the host — put that directory on off-host
# storage, or a disk failure takes the backups with the database.
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
