# Build context for ml/Dockerfile (context = backend/ml).
#
# The Dockerfile only needs pyproject.toml, README.md and src/. Everything below
# is either rebuilt inside the image or mounted at runtime, and .venv alone is
# ~390 MB of host-specific binaries that would be useless in a Linux image.

# Local virtualenv — platform-specific, reinstalled by pip in the image.
.venv/

# models/ is deliberately NOT ignored. The production image bakes the checkpoint
# in (see ml/Dockerfile) so that an image tag names both the code and the model
# it serves, and a rollback returns to the model the old version was validated
# against. It stays out of git; CI fetches it into this directory before build.
#
# The development compose still mounts ../ml/models over /models, which shadows
# the baked copy — so a locally trained checkpoint keeps working with no rebuild.

# Generated corpora, splits and eval fixtures are training-time inputs. Inference
# never reads them.
data/

# Notebooks are exploration, not runtime.
notebooks/

# Python build and test artefacts
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Tests are run by `make ml-test` on the host, not inside the runtime image.
tests/

# Environment
.env
.env.local

# OS noise
.DS_Store
