.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/
.DS_Store

# Trained artefacts and large local corpora
models/**
!models/.gitkeep
data/generated/**
!data/generated/.gitkeep
data/splits/**
!data/splits/.gitkeep
# Third-party downloads: keep provenance in git, keep the payload out.
data/external/**
!data/external/**/
!data/external/**/SOURCE.md
# Keep small committed eval fixtures; ignore large downloads
data/eval/ood_raw*
data/eval/*.parquet
!data/eval/.gitkeep
!data/eval/relabel_guide.md
!data/eval/sample_labeled.csv
