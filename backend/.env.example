# TicketLens backend — copy to .env and adjust. Every value here is the code
# default, so an empty .env behaves exactly like no .env at all.
#
#   cp .env.example .env
#
# .env is gitignored; .env.example is not. Never put a real secret in this file.

# ─── Server ───────────────────────────────────────────────────────────────────
APP_ENV=development
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# ─── Database ─────────────────────────────────────────────────────────────────
# Matches the credentials in deployments/docker-compose.yml.
DB_HOST=localhost
DB_PORT=5432
DB_USER=masterfabric
DB_PASSWORD=masterfabric
DB_NAME=masterfabric

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── Auth ─────────────────────────────────────────────────────────────────────
# The default is rejected at startup when APP_ENV is not development, and must
# be at least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_HOURS=24

# ─── Kafka ────────────────────────────────────────────────────────────────────
KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=masterfabric-go

# ─── Classifier (ml/) ─────────────────────────────────────────────────────────
# CLASSIFIER_URL empty  → in-process keyword stub, no Python service needed.
# CLASSIFIER_URL set    → the FastAPI service from ml/ (./dev.sh classifier).
#
# Leave it empty unless the container is actually running: pointing at a dead
# port makes every ticket analysis wait out CLASSIFIER_TIMEOUT_MS before falling
# back. ./dev.sh server auto-detects the running container and sets this for you.
CLASSIFIER_URL=
CLASSIFIER_TIMEOUT_MS=5000
CLASSIFIER_MAX_RETRIES=2
CLASSIFIER_FALLBACK_TO_STUB=true
# Confidence below this flags the analysis as needs_human_review. The frontend
# reads that flag rather than this number, so changing it here is enough.
CLASSIFIER_REVIEW_THRESHOLD=0.60

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json
