# TicketLens backend — copy to .env and adjust. Every value here is the code
# default, so an empty .env behaves exactly like no .env at all.
#
#   cp .env.example .env
#
# .env is gitignored; .env.example is not. Never put a real secret in this file.

# ─── Server ───────────────────────────────────────────────────────────────────
APP_ENV=development
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# ─── Database ─────────────────────────────────────────────────────────────────
# Matches the credentials in deployments/docker-compose.yml.
DB_HOST=localhost
DB_PORT=5432
DB_USER=masterfabric
DB_PASSWORD=masterfabric
DB_NAME=masterfabric

# TLS to the database. `disable` is right for a loopback or private-network
# Postgres; use `require` (or stronger) for anything managed or remote. The
# server logs a warning at startup if this is left disabled in production.
DB_SSLMODE=disable

# Whether the server applies pending migrations on the way up. Defaults to true
# in development — that is what lets ./start.sh work on a fresh checkout — and
# false in every other APP_ENV, where migrations are their own deploy step:
#
#   go run ./cmd/migrate            apply
#   go run ./cmd/migrate -status    list what is pending
#
# With this off, a server that finds pending migrations refuses to start rather
# than serve against a schema it was not built for.
# DB_AUTO_MIGRATE=true

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── Auth ─────────────────────────────────────────────────────────────────────
# The default is rejected at startup when APP_ENV is not development, and must
# be at least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_HOURS=24

# ─── Kafka ────────────────────────────────────────────────────────────────────
KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=masterfabric-go

# ─── Classifier (ml/) ─────────────────────────────────────────────────────────
# CLASSIFIER_URL empty  → in-process keyword stub, no Python service needed.
# CLASSIFIER_URL set    → the FastAPI service from ml/ (./dev.sh classifier).
#
# Leave it empty unless the container is actually running: pointing at a dead
# port makes every ticket analysis wait out CLASSIFIER_TIMEOUT_MS before falling
# back. ./dev.sh server auto-detects the running container and sets this for you.
CLASSIFIER_URL=
CLASSIFIER_TIMEOUT_MS=5000
CLASSIFIER_MAX_RETRIES=2
CLASSIFIER_FALLBACK_TO_STUB=true
# Confidence below this flags the analysis as needs_human_review. The frontend
# reads that flag rather than this number, so changing it here is enough.
CLASSIFIER_REVIEW_THRESHOLD=0.60

# ─── Onboarding ───────────────────────────────────────────────────────────────
# Whether POST /auth/register is mounted at all. Defaults to true in development
# (make seed and ./start.sh rely on it) and false everywhere else, where staff
# arrive through invitations instead. When off the route is not registered, so it
# answers 404 rather than advertising itself.
# ALLOW_PUBLIC_REGISTRATION=true

# Base of the invitation link, i.e. the address the recipient opens in their own
# browser. This is the public frontend, never an internal service name. Startup
# refuses a value still pointing at localhost outside development.
PUBLIC_APP_URL=http://localhost:3000

# How long an invitation stays redeemable. 168 hours = 7 days.
INVITATION_TTL_HOURS=168

# ─── Mail ─────────────────────────────────────────────────────────────────────
# SMTP_HOST empty → messages are written to the log instead of being sent, with
# the invitation link in full. Same shape as the classifier stub: development and
# tests need no mail server, and the link is read out of the server log.
#
# Setting it switches to real delivery; the rest of these are then required.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=TicketLens <no-reply@localhost>
SMTP_TIMEOUT_SECONDS=10

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json
