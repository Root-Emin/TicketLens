# TicketLens frontend — copy to .env.local and adjust.
#
# There is deliberately no NEXT_PUBLIC_ variable here. The browser never calls
# the Go backend directly: it calls /api/proxy/*, and the Next server attaches
# the JWT from an httpOnly cookie. So the backend address is a server-side
# value, and giving it a NEXT_PUBLIC_ name would inline the internal address
# into the client bundle for no benefit.

# Go backend base URL, read only in route handlers (src/lib/server/backend.ts).
API_URL=http://localhost:8080
