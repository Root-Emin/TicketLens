# Build context for frontend/Dockerfile.
#
# node_modules is excluded on purpose: the image installs from the lockfile
# (npm ci) so the build never inherits whatever a developer's machine happens to
# have resolved, and copying a macOS tree into a Linux image would ship native
# binaries that cannot run there.
node_modules/

# Build outputs — regenerated inside the image.
.next/
out/
dist/
tsconfig.tsbuildinfo
next-env.d.ts

# Environment — never bake local secrets into an image layer. The runtime reads
# API_URL from the container environment instead.
.env
.env.*
!.env.example

# VCS and tooling
.git/
.gitignore
.github/
.claude/

# Docs and repo furniture
*.md
!README.md

# OS noise
.DS_Store
Thumbs.db
